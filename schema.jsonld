    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is InclusiFund for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "UK grassroots community organisations — CICs (Community Interest Companies), small charities, and community-run businesses, especially those below the £1M income threshold where most institutional funding stops looking."
          }
        },
        {
          "@type": "Question",
          "name": "What does InclusiFund actually do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We pair grant-matching and application-writing with building the tools those operators need — websites, director dashboards, and content systems. AntiGravity Projects is our build arm that delivers the technology side."
          }
        },
        {
          "@type": "Question",
          "name": "Who runs InclusiFund?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "InclusiGroup Ltd is the registered company; InclusiFund is the brand. Founder: Reece Dunn. Contact: reece.dunn@inclusifund.co.uk."
          }
        },
        {
          "@type": "Question",
          "name": "What are the related InclusiFund surfaces?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "studio.inclusifund.co.uk (portfolio + studio landing pages), aiq.inclusifund.co.uk (AI fluency assessment), community.inclusifund.co.uk (member community), and tools.inclusifund.co.uk (the CIC toolkit)."
          }
        }
      ]
